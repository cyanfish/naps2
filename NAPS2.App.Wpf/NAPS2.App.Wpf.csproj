<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <OutputType>WinExe</OutputType>
    <RootNamespace>NAPS2</RootNamespace>
    <AssemblyName>NAPS2</AssemblyName>
    <ApplicationIcon>../NAPS2.Lib/Icons/favicon.ico</ApplicationIcon>

    <SelfContained>true</SelfContained>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <PublishTrimmed>false</PublishTrimmed>
    <TrimMode>none</TrimMode>
    <UseWPF>true</UseWPF>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <CETCompat>false</CETCompat>
    <NoWarn>$(NoWarn);NU1701</NoWarn>

    <Title>NAPS2 - Not Another PDF Scanner</Title>
    <Product>NAPS2 - Not Another PDF Scanner</Product>
  </PropertyGroup>

  <Import Project="..\NAPS2.Setup\targets\CommonTargets.targets" />
  <Import Project="..\NAPS2.Setup\targets\NativeLibs.targets" />
  <Import Project="..\NAPS2.Setup\targets\PublishExclusions.targets" />
  <Import Project="..\NAPS2.Setup\targets\ReadyToRun.Wpf.targets" />
  <Import Project="..\NAPS2.Setup\targets\SingleFile.targets" />
  <Import Project="..\NAPS2.Setup\targets\SdkUsers.targets" />

  <ItemGroup>
    <PackageReference Include="NAPS2.Jpeg.Binaries" Version="1.0.0" />
    <PackageReference Include="NAPS2.Pdfium.Binaries" Version="1.3.0" />
    <PackageReference Include="NAPS2.Tesseract.Binaries" Version="1.5.0" />

    <ProjectReference Include="..\NAPS2.Lib.Wpf\NAPS2.Lib.Wpf.csproj" />

    <ProjectReference Include="..\NAPS2.App.Console\NAPS2.App.Console.csproj"
                      ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true"
                      SetTargetFramework="TargetFramework=net462" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained"
                      OutputItemType="Content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ContentWithTargetPath Include="..\NAPS2.Setup\appsettings.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Link>appsettings.xml</Link>
      <TargetPath>appsettings.xml</TargetPath>
    </ContentWithTargetPath>
  </ItemGroup>
</Project>

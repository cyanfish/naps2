<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- A plain list item template for thumbnails. -->
    <ControlTemplate x:Key="ThumbnailItemTemplate" TargetType="ListBoxItem">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
            <ContentPresenter />
        </Border>
    </ControlTemplate>

    <!-- A list item template that shows the content as a checkbox, checked when the item is selected. -->
    <ControlTemplate x:Key="CheckBoxItemTemplate" TargetType="ListBoxItem">
        <CheckBox Content="{TemplateBinding Content}" Focusable="False" Margin="4,0"
                  IsChecked="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
    </ControlTemplate>

    <!-- A minimal button template. -->
    <ControlTemplate x:Key="SubtleButtonTemplate" TargetType="Button">
        <Border x:Name="bd" Background="Transparent" CornerRadius="4">
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
            </Trigger>
            <!-- WPF doesn't grey out images in disabled buttons -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- The Fluent GroupBox has no border, so this puts the header above a rounded "card" border. The header height
         must match GROUP_BOX_HEADER_HEIGHT in WpfEtoPlatform. -->
    <ControlTemplate x:Key="CardGroupBoxTemplate" TargetType="GroupBox">
        <DockPanel>
            <ContentPresenter DockPanel.Dock="Top" Height="26" Margin="2,0,0,0" ContentSource="Header"
                              RecognizesAccessKey="True" />
            <Border CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <ContentPresenter />
            </Border>
        </DockPanel>
    </ControlTemplate>

    <!-- A Fluent-like focus rectangle drawn inside the button (the default one extends outside, which gets clipped at
         the edges of the toolbar) -->
    <Style x:Key="InsetFocusVisualStyle">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderBrush="{DynamicResource FocusStrokeColorOuterBrush}" BorderThickness="2"
                            CornerRadius="4" SnapsToDevicePixels="True">
                        <Border BorderBrush="{DynamicResource FocusStrokeColorInnerBrush}" BorderThickness="1"
                                CornerRadius="2" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

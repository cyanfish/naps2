<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <Import Project="ReadyToRun.targets" />

    <PropertyGroup>
        <!-- Composite is usually better, but in the worker case added more size for no measurable improvement -->
        <PublishReadyToRunComposite>false</PublishReadyToRunComposite>
    </PropertyGroup>

    <!-- Assemblies loaded during startup (per AppDomain.GetAssemblies()) and common operations like scanning -->
    <ItemGroup>
        <Naps2ReadyToRunAssembly Include="System.Collections.dll" />
        <Naps2ReadyToRunAssembly Include="System.Console.dll" />
        <Naps2ReadyToRunAssembly Include="System.Diagnostics.Process.dll" />
        <Naps2ReadyToRunAssembly Include="System.IO.Pipes.dll" />
        <Naps2ReadyToRunAssembly Include="System.Linq.dll" />
        <Naps2ReadyToRunAssembly Include="System.Private.CoreLib.dll" />

        <Naps2ReadyToRunAssembly Include="Google.Protobuf.dll" />
        <Naps2ReadyToRunAssembly Include="Grpc.Core.Api.dll" />
        <Naps2ReadyToRunAssembly Include="GrpcDotNetNamedPipes.dll" />
        <Naps2ReadyToRunAssembly Include="NAPS2.Sdk.dll" />
        <Naps2ReadyToRunAssembly Include="NAPS2.Worker.dll" />

        <Naps2ReadyToRunAssembly Include="NTwain.dll" />
    </ItemGroup>

</Project>
